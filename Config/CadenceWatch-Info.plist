<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Watch keeps its own store; it syncs with the phone over WatchConnectivity, not the App Group. -->
	<key>WKApplication</key>
	<true/>
	<!-- Keeps the HealthKit workout session (live heart rate) running with the screen off. -->
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
</dict>
</plist>
